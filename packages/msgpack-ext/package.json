{
  "name": "@vgerbot/msgpack-ext",
  "description": "An extended version of @msgpack/msgpack library, providing enhanced serialization and deserialization capabilities with support for additional data types and circular references",
  "version": "1.0.0",
  "main": "lib/index.cjs.js",
  "browser": "lib/index.umd.js",
  "module": "lib/index.es.js",
  "typings": "lib/index.d.ts",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.es.js",
      "browser": "./lib/index.umd.js",
      "require": "./lib/index.cjs.js",
      "types": "./lib/index.d.ts"
    }
  },
  "library": "MPext",
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vgerbot-libraries/solidium.git"
  },
  "keywords": [
    "msgpack",
    "MessagePack",
    "circular-references",
    "circular",
    "serialization",
    "deserialization",
    "binary",
    "data",
    "data-structures",
    "structures",
    "structures-clone",
    "clone",
    "serialize",
    "deserialize",
    "encode",
    "decode",
    "typedarray",
    "ext",
    "universal",
    "codecs"
  ],
  "scripts": {
    "build": "rollup -c ../../rollup.config.js",
    "test": "cross-env NODE_ENV=test jest -c ../../jest.config.js --passWithNoTests",
    "lint": "eslint 'src/**/*.{ts,tsx}' '__tests__/**/*.{ts,tsx}' --no-error-on-unmatched-pattern",
    "format": "eslint --fix 'src/**/*.{ts,tsx}' '__tests__/**/*.{ts,tsx}' --no-error-on-unmatched-pattern"
  },
  "bugs": {
    "url": "https://github.com/vgerbot-libraries/solidium/issues"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0-beta3",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^24.7.2"
  }
}
