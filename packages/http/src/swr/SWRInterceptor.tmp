
import { Interceptor, InterceptorNextFunction } from '../core/Interceptor';
import { ExecuteRequestMethodParams } from '../core/ExecuteRequestParams';
import { RequestMethod } from '../core/RequestMethod';
import { HttpResponse } from '../core/HttpResponse';
import { Events } from '../common/Events';

interface CacheEntry {
    response: HttpResponse;
    timestamp: number;
    isValidating: boolean;
    error?: Error;
    errorCount?: number;
    revalidateInterval?: number;
    lastRevalidateCheck?: number;
}

interface RevalidateEvent {
    key: string;
    response: HttpResponse;
}

interface RetryConfig {
    retryCount: number;
    interval: number;
    backoff?: boolean;
    shouldRetryOnError?: (error: Error) => boolean;
}

export interface SWRConfig {
    dedupingInterval?: number;
    revalidateOnFocus?: boolean;
    focusThrottleInterval?: number;
    retry?: RetryConfig;
    revalidateInterval?: number;
}

export class StaleWhileRevalidateInterceptor implements Interceptor {
    private cache = new Map<string, CacheEntry>();
    private revalidatingKeys = new Set<string>();
    private events = new Events();
    private config: Required<SWRConfig>;
    private lastFocusRevalidation = 0;
    private revalidateIntervalTimers = new Map<string, number>();

    constructor(config: SWRConfig = {}) {
        this.config = {
            dedupingInterval: config.dedupingInterval ?? 2000,
            revalidateOnFocus: config.revalidateOnFocus ?? true,
            focusThrottleInterval: config.focusThrottleInterval ?? 5000,
            revalidateInterval: config.revalidateInterval ?? 0,
            retry: {
                retryCount: config.retry?.retryCount ?? 3,
                interval: config.retry?.interval ?? 1000,
                backoff: config.retry?.backoff ?? true,
                shouldRetryOnError: (error: Error) =>
                    config.retry?.shouldRetryOnError?.(error) ?? true
            }
        };

        if (typeof window !== 'undefined' && this.config.revalidateOnFocus) {
            window.addEventListener('focus', this.onWindowFocus);
        }
    }

    private onWindowFocus = () => {
        const now = Date.now();
        if (
            now - this.lastFocusRevalidation <
            this.config.focusThrottleInterval
        ) {
            return;
        }
        this.lastFocusRevalidation = now;
        this.revalidateAll();
    };

    private getCacheKey(
        method: RequestMethod,
        params: ExecuteRequestMethodParams
    ): string {
        const url = method.resolveURL(params);
        const httpMethod = method.getHttpMethod();
        return `${httpMethod}:${url}`;
    }

    private setupRevalidateInterval(
        method: RequestMethod,
        params: ExecuteRequestMethodParams,
        next: InterceptorNextFunction,
        cacheKey: string,
        interval: number
    ): void {
        if (interval <= 0) return;

        // Clear existing timer if any
        const existingTimer = this.revalidateIntervalTimers.get(cacheKey);
        if (existingTimer) {
            clearInterval(existingTimer);
        }

        // Setup new timer
        const timer = setInterval(() => {
            const entry = this.cache.get(cacheKey);
            if (entry && !entry.isValidating) {
                this.revalidate(method, params, next, cacheKey);
            }
        }, interval);

        this.revalidateIntervalTimers.set(cacheKey, timer);
    }

    private async retryRequest(
        method: RequestMethod,
        params: ExecuteRequestMethodParams,
        next: InterceptorNextFunction,
        cacheKey: string,
        retryCount: number
    ): Promise<HttpResponse> {
        try {
            const response = await next(method, params);
            return response;
        } catch (error) {
            const shouldRetry =
                error instanceof Error &&
                (this.config.retry.shouldRetryOnError
                    ? this.config.retry.shouldRetryOnError(error)
                    : true) &&
                retryCount > 0;

            if (!shouldRetry) throw error;

            const entry = this.cache.get(cacheKey);
            const currentErrorCount = (entry?.errorCount || 0) + 1;
            const delay = this.config.retry.backoff
                ? this.config.retry.interval *
                  Math.pow(2, currentErrorCount - 1)
                : this.config.retry.interval;

            await new Promise(resolve => setTimeout(resolve, delay));
            return this.retryRequest(
                method,
                params,
                next,
                cacheKey,
                retryCount - 1
            );
        }
    }

    private async revalidate(
        method: RequestMethod,
        params: ExecuteRequestMethodParams,
        next: InterceptorNextFunction,
        cacheKey: string
    ): Promise<void> {
        if (this.revalidatingKeys.has(cacheKey)) {
            return;
        }

        try {
            this.revalidatingKeys.add(cacheKey);
            const freshResponse = await this.retryRequest(
                method,
                params,
                next,
                cacheKey,
                this.config.retry.retryCount
            );

            const entry: CacheEntry = {
                response: freshResponse,
                timestamp: Date.now(),
                isValidating: false,
                errorCount: 0,
                revalidateInterval: this.config.revalidateInterval,
                lastRevalidateCheck: Date.now()
            };

            this.cache.set(cacheKey, entry);
            this.setupRevalidateInterval(
                method,
                params,
                next,
                cacheKey,
                this.config.revalidateInterval
            );

            this.events.emit('revalidate', {
                key: cacheKey,
                response: freshResponse
            });
        } catch (error) {
            const entry = this.cache.get(cacheKey);
            if (entry) {
                entry.isValidating = false;
                entry.error =
                    error instanceof Error ? error : new Error(String(error));
                entry.errorCount = (entry.errorCount || 0) + 1;
            }
            throw error;
        } finally {
            setTimeout(() => {
                this.revalidatingKeys.delete(cacheKey);
            }, this.config.dedupingInterval);
        }
    }

    private shouldRevalidate(entry: CacheEntry): boolean {
        if (entry.isValidating) return false;

        const now = Date.now();

        // Check revalidate interval
        if (entry.revalidateInterval && entry.lastRevalidateCheck) {
            if (now - entry.lastRevalidateCheck >= entry.revalidateInterval) {
                return true;
            }
        }

        return true;
    }

    async invoke(
        method: RequestMethod,
        params: ExecuteRequestMethodParams,
        next: InterceptorNextFunction
    ): Promise<HttpResponse> {
        const cacheKey = this.getCacheKey(method, params);
        const cachedEntry = this.cache.get(cacheKey);

        if (cachedEntry) {
            if (this.shouldRevalidate(cachedEntry)) {
                cachedEntry.isValidating = true;
                cachedEntry.lastRevalidateCheck = Date.now();
                this.revalidate(method, params, next, cacheKey).catch(() => {
                    // Swallow error since we're returning stale data
                });
            }
            return cachedEntry.response;
        }

        try {
            this.revalidatingKeys.add(cacheKey);
            const response = await this.retryRequest(
                method,
                params,
                next,
                cacheKey,
                this.config.retry.retryCount
            );

            const entry: CacheEntry = {
                response,
                timestamp: Date.now(),
                isValidating: false,
                errorCount: 0,
                revalidateInterval: this.config.revalidateInterval,
                lastRevalidateCheck: Date.now()
            };

            this.cache.set(cacheKey, entry);
            this.setupRevalidateInterval(
                method,
                params,
                next,
                cacheKey,
                this.config.revalidateInterval
            );

            return response;
        } finally {
            setTimeout(() => {
                this.revalidatingKeys.delete(cacheKey);
            }, this.config.dedupingInterval);
        }
    }

    onRevalidate(callback: (event: RevalidateEvent) => void): () => void {
        return this.events.on('revalidate', callback);
    }

    async revalidateAll(): Promise<void> {
        const entries = Array.from(this.cache.entries());
        await Promise.all(
            entries.map(([key, entry]) => {
                if (!entry.isValidating) {
                    entry.isValidating = true;
                    entry.lastRevalidateCheck = Date.now();
                    this.cache.set(key, entry);
                }
            })
        );
    }

    async revalidateCache(cacheKey: string): Promise<void> {
        const entry = this.cache.get(cacheKey);
        if (!entry) return;

        entry.isValidating = true;
        entry.lastRevalidateCheck = Date.now();
        this.cache.set(cacheKey, entry);
    }

    invalidate(cacheKey: string): void {
        const timer = this.revalidateIntervalTimers.get(cacheKey);
        if (timer) {
            clearInterval(timer);
            this.revalidateIntervalTimers.delete(cacheKey);
        }
        this.cache.delete(cacheKey);
        this.revalidatingKeys.delete(cacheKey);
    }

    clear(): void {
        this.revalidateIntervalTimers.forEach(timer => clearInterval(timer));
        this.revalidateIntervalTimers.clear();
        this.cache.clear();
        this.revalidatingKeys.clear();
    }

    dispose(): void {
        if (typeof window !== 'undefined') {
            window.removeEventListener('focus', this.onWindowFocus);
        }
        this.clear();
    }
}
