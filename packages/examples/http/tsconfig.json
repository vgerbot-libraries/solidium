{
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"declaration": false,
		"noImplicitThis": false,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"useDefineForClassFields": false,
		"moduleResolution": "bundler",
		"downlevelIteration": true
	},
	"extends": "../tsconfig.json",
	"include": ["./src/"]
}
