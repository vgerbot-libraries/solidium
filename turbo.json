{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["lib/**", "dist/**", "!lib/**/*.test.*", "!dist/**/*.test.*"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**", "report/**"]
    },
    "lint": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "clear": {
      "cache": false
    },
    "typedoc": {
      "dependsOn": ["build"],
      "outputs": ["docs/**", "dist/docs/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
